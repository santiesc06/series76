# Copy to .env and fill in the values:  cp .env.example .env

# --- LLM (OpenRouter) ---------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model used by the chat agent (must support tool calling). See README "Model choices".
LLM_MODEL=choose-a-tool-calling-model
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024

# --- Ingestion (only needed to re-run table extraction from the PDF) ----------
# Vision model used by `ingest.py extract`. Loading the verified data does NOT need it.
EXTRACTION_MODEL=choose-a-vision-model

# --- Database ------------------------------------------------------------------
POSTGRES_USER=series76
POSTGRES_PASSWORD=series76
POSTGRES_DB=series76
# Host port. 5433 avoids clashing with a PostgreSQL already installed on your machine.
POSTGRES_PORT=5433
# Used when running the backend outside Docker. Inside Docker Compose the host is "db".
DATABASE_URL=postgresql+psycopg://series76:series76@localhost:5433/series76

# --- API -----------------------------------------------------------------------
API_PORT=8000
LOG_LEVEL=INFO
# How many previous messages of a session are sent to the LLM as context.
HISTORY_WINDOW=12
