# Copy to .env and fill in the values:  cp .env.example .env

# --- LLM (OpenRouter) ---------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model used by the chat agent (must support tool calling). See README "Model choices".
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=30
MAX_TOOL_ITERATIONS=6
# USD per 1M tokens of LLM_MODEL, used only to log an estimated cost per request.
LLM_PRICE_INPUT_PER_M=0.10
LLM_PRICE_OUTPUT_PER_M=0.50

# --- Ingestion (only needed to re-run table extraction from the PDF) ----------
# Loading the verified data (`ingest load`, done automatically by Docker) needs NONE of these.
# Two vision models from different families extract the tables; their results are diffed.
# Both use an OpenAI-compatible API, so any provider works: set URL + key + model.
# Model A: Gemini via Google AI Studio (free tier). Key: https://aistudio.google.com/apikey
EXTRACTION_A_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EXTRACTION_A_API_KEY=your-google-ai-studio-key
EXTRACTION_A_MODEL=gemini-3.5-flash
# Model B: a non-Google model via OpenRouter (uses OPENROUTER_API_KEY if left empty).
EXTRACTION_B_BASE_URL=https://openrouter.ai/api/v1
EXTRACTION_B_API_KEY=
EXTRACTION_B_MODEL=anthropic/claude-haiku-5.5

# --- Database ------------------------------------------------------------------
POSTGRES_USER=series76
POSTGRES_PASSWORD=series76
POSTGRES_DB=series76
# Host port. 5433 avoids clashing with a PostgreSQL already installed on your machine.
POSTGRES_PORT=5433
# Used when running the backend outside Docker. Inside Docker Compose the host is "db".
DATABASE_URL=postgresql+psycopg://series76:series76@localhost:5433/series76

# --- API -----------------------------------------------------------------------
# Host port of the backend container (change it if 8000 is already in use on your machine).
API_PORT=8000
LOG_LEVEL=INFO
# How many previous messages of a session are sent to the LLM as context.
HISTORY_WINDOW=12
# Developer endpoint GET /api/messages/{id}/debug (tool calls, tokens). Set false in production.
DEBUG_ENDPOINTS=true
# Login tokens expire after this many hours (design U1). Test users: README section 9.
AUTH_TOKEN_TTL_HOURS=168

# --- Optional: Langfuse tracing (design Q6) --------------------------------------
# Leave empty to disable. With both keys set, every agent turn is traced to Langfuse Cloud.
# Keys: https://cloud.langfuse.com -> project -> Settings -> API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region by default; US region: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
